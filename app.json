{
  "expo": {
    "name": "ClearEarth",
    "slug": "clearearth-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "clearearth-driver",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clearearth.driver",
      "infoPlist": {
        "NSCameraUsageDescription": "ClearEarth uses your camera to photograph pickups and inspections.",
        "NSPhotoLibraryUsageDescription": "ClearEarth needs access to your photo library so you can attach existing photos."
      }
    },
    "android": {
      "package": "com.clearearth.driver",
      "adaptiveIcon": {
        "backgroundColor": "#10B981",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "ClearEarth needs access to your photo library so you can attach existing photos.",
          "cameraPermission": "ClearEarth uses your camera to photograph pickups and inspections."
        }
      ],
      "expo-image",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "edgeToEdgeEnabled": true
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
