# Copy to .env and adjust for your setup.
# If unset, the app guesses your dev machine's LAN IP from the Metro connection
# (usually works fine for `expo start` on the same network). Set this explicitly
# for staging/production builds, or if the auto-guess doesn't work for you.
EXPO_PUBLIC_API_URL=http://192.168.1.23:3000/api/v1
